{
  "files.associations": {
    "**/templates/*.yaml": "helm",
    "**/templates/*.yml": "helm",
    "**/templates/*.tpl": "helm"
  },
  "[yaml]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "[helm]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "yaml.format.enable": false,
  "prettier.disableLanguages": ["yaml", "helm"]
}
